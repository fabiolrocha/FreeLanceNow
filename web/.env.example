VITE_DATA_MODE=api
VITE_API_BASE_URL=/api/v1
# Só o proxy Vite usa esta URL; o navegador chama /api/v1.
API_PROXY_TARGET=http://localhost:8081
# Opcional: e-mail de contato exibido em Ajuda, Termos e Privacidade (público, entra no bundle).
VITE_SUPPORT_EMAIL=

# Produção na Vercel (Settings → Environment Variables), nunca segredos em VITE_*:
# VITE_DATA_MODE=api
# VITE_API_BASE_URL=https://<servico>.onrender.com/api/v1
