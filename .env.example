# Valores exclusivos do ambiente local acadêmico. Troque em qualquer deploy.
# Banco PostgreSQL (Docker local ou URL JDBC do Neon Serverless)
DB_URL=jdbc:postgresql://localhost:5435/freelancenow
DB_USERNAME=freelancenow
DB_PASSWORD=freelancenow-local
DB_PORT=5435
API_PORT=8081
WEB_PORT=5173
JWT_SECRET=freelancenow-local-development-key-change-before-deploy-2026
VITE_DATA_MODE=mock

# Integrações definidas no Passo 0 (Stripe sandbox, Resend e-mail)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
PLATFORM_FEE_PERCENT=10
RESEND_API_KEY=re_placeholder
RESEND_FROM_EMAIL=no-reply@freelancenow.test

# Provisionamento explícito de ADMIN. Habilite só para a criação inicial e desabilite depois.
# Não há conta/senha administrativa padrão. Use credenciais próprias no .env ignorado.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Administrador
