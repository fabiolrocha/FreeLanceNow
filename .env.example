# Valores exclusivos do ambiente local acadêmico. Troque em qualquer deploy.
# Banco PostgreSQL (Docker local ou URL JDBC do Neon Serverless)
DB_URL=jdbc:postgresql://localhost:5435/freelancenow
DB_USERNAME=freelancenow
DB_PASSWORD=freelancenow-local
DB_PORT=5435
API_PORT=8081
WEB_PORT=5173
JWT_SECRET=freelancenow-local-development-key-change-before-deploy-2026
VITE_DATA_MODE=api
# Opcional: contato exibido em Ajuda, Termos e Privacidade (público, entra no bundle da web).
VITE_SUPPORT_EMAIL=

# Integrações definidas no Passo 0 (Stripe sandbox, Resend e-mail)
# Stripe em modo de teste (F09). Vazio desliga os pagamentos; chaves sk_live_ são recusadas.
STRIPE_SECRET_KEY=
# Chave publicável (pk_test_...): a API a entrega ao navegador para os componentes do Connect.
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Segredo do endpoint "Connect" (eventos das contas dos profissionais). Com stripe listen, use o mesmo whsec_.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Formas oferecidas no Checkout. Pix e boleto exigem conta Stripe brasileira com o método ativo.
STRIPE_PAYMENT_METHODS=CARD,PIX,BOLETO
PLATFORM_FEE_PERCENT=10
# Resend: sem chave real, o dev registra o e-mail no log e o prod só avisa.
# Em produção use um remetente de domínio verificado no Resend, ex.: FreeLanceNow <no-reply@seu-dominio>
RESEND_API_KEY=re_placeholder
RESEND_FROM_EMAIL=no-reply@freelancenow.test
# URL pública do frontend usada nos links de e-mail (vazio: Compose usa http://127.0.0.1:WEB_PORT)
PUBLIC_APP_URL=
# Produção (Render): CORS_ORIGINS=https://<projeto>.vercel.app e PUBLIC_APP_URL com a mesma origem.
# Validade do refresh token em segundos (padrão 30 dias)
JWT_REFRESH_TTL_SECONDS=2592000

# Provisionamento explícito de ADMIN. Habilite só para a criação inicial e desabilite depois.
# Não há conta/senha administrativa padrão. Use credenciais próprias no .env ignorado.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Administrador
